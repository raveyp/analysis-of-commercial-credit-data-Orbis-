# ============================================================
# Comparative statistics between quartiles
# ============================================================

# Calculate comparative statistics
comparative_stats <- country_quartile_averages %>%
  group_by(Country, year) %>%
  summarise(
    q1_receivables = avg_receivables_millions[quartile_label == "Quartile 1 (Smallest Firms)"],
    q4_receivables = avg_receivables_millions[quartile_label == "Quartile 4 (Largest Firms)"],
    q1_payables = avg_payables_millions[quartile_label == "Quartile 1 (Smallest Firms)"],
    q4_payables = avg_payables_millions[quartile_label == "Quartile 4 (Largest Firms)"],
    .groups = "drop"
  ) %>%
  mutate(
    receivables_ratio = q4_receivables / q1_receivables,
    payables_ratio = q4_payables / q1_payables
  )

# Save comparative statistics
write_xlsx(comparative_stats, "~/Desktop/Quartile_Comparative_Statistics.xlsx")

