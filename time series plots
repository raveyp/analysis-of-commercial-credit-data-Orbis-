# Calculate credit ratio
country_quartile_ratio <- country_quartile_averages %>%
  mutate(
    credit_ratio = avg_payables_millions / avg_receivables_millions,
    log_credit_ratio = log(credit_ratio)
  )

# Credit ratio for Quartile 1 (log scale)
q1_ratio_plot <- ggplot(country_quartile_ratio %>% 
                          filter(quartile_label == "Quartile 1 (Smallest Firms)", 
                                 !is.na(log_credit_ratio), is.finite(log_credit_ratio)),
                        aes(x = year, y = log_credit_ratio)) +
  geom_line(color = "steelblue", linewidth = 1) +
  geom_point(color = "steelblue", size = 1.5, alpha = 0.7) +
  geom_hline(yintercept = 0, color = "red", linetype = "dashed", linewidth = 1) +
  facet_wrap(~ Country, scales = "free_y", ncol = 4) +
  labs(
    title = "Credit Ratio (Payables/Receivables) - Quartile 1 (Smallest Firms)",
    subtitle = "log(Trade Creditors / Accounts Receivable) | Values > 0 indicate net credit buyers",
    x = "Year",
    y = "log(Trade Creditors / Accounts Receivable)",
    caption = "Positive values: net credit buyers | Negative values: net credit sellers"
  ) +
  theme_minimal() +
  theme(
    legend.position = "bottom",
    axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
    strip.text = element_text(face = "bold", size = 10),
    plot.title = element_text(hjust = 0.5, face = "bold"),
    plot.subtitle = element_text(hjust = 0.5, size = 9)
  ) +
  scale_x_continuous(breaks = seq(2005, 2020, by = 5))

