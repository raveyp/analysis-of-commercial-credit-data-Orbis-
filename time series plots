  mutate(
    net_position_millions = avg_receivables_millions - avg_payables_millions
  )

# Net credit position for Quartile 1
q1_net_plot <- ggplot(country_quartile_net %>% 
                        filter(quartile_label == "Quartile 1 (Smallest Firms)", 
                               !is.na(net_position_millions)),
                      aes(x = year, y = net_position_millions)) +
  geom_line(color = "steelblue", linewidth = 1) +
  geom_point(color = "steelblue", size = 1.5, alpha = 0.7) +
  geom_hline(yintercept = 0, color = "red", linetype = "dashed", linewidth = 1) +
  facet_wrap(~ Country, scales = "free_y", ncol = 4) +
  labs(
    title = "Average Net Credit Position - Quartile 1 (Smallest Firms)",
    subtitle = "Accounts Receivable minus Accounts Payable (Millions USD)",
    x = "Year",
    y = "Net Position (Millions USD)",
    caption = "Positive values: net credit providers | Negative values: net credit users"
  ) +
  theme_minimal() +
  theme(
    legend.position = "bottom",
    axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
    strip.text = element_text(face = "bold", size = 10),
    plot.title = element_text(hjust = 0.5, face = "bold"),
    plot.subtitle = element_text(hjust = 0.5, size = 9)
  ) +
  scale_x_continuous(breaks = seq(2005, 2020, by = 5))

