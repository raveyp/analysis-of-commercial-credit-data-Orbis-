Appendix B: R code for time series plots of accounts receivable and payable for quartiles 1 & 4 of sample

library(tidyverse)
library(readxl)
library(ggplot2)
library(scales)

# Read the Excel file
orbis_data <- read_excel("East Asian Manufacturing Trade Credit/East_Asia_Orbis_transposed_with_quartiles.xlsx")

### read_excel("Desktop/PhD/Chapters/C&C Article/Second Revision/WTO:BIS Data/G7_Orbis_Transposed_with_Ratio.xlsx") ###
### same code but swap for G7 data: read_excel("Desktop/PhD/Chapters/C&C Article/Second Revision/WTO:BIS Data/East_Asia_Orbis_transposed_with_quartiles.xlsx") ###

# Filter to years 2003-2023 and quartiles 1 and 4
quartile_data <- orbis_data %>%
  filter(year >= 2003 & year <= 2023) %>%
  filter(quartile %in% c(1, 4)) %>%
  # Create factor for quartile with labels
  mutate(
    quartile_label = factor(quartile, 
                            levels = c(1, 4), 
                            labels = c("Quartile 1 (Smallest Firms)", 
                                       "Quartile 4 (Largest Firms)"))
  )

# Calculate average accounts receivable and payable by country, year, and quartile
country_quartile_averages <- quartile_data %>%
  group_by(Country, year, quartile_label) %>%
  summarise(
    avg_receivables = mean(Accounts_receivable_USD, na.rm = TRUE),
    avg_payables = mean(Trade_creditors_USD, na.rm = TRUE),
    n_firms = n_distinct(Company),
    n_receivables = sum(!is.na(Accounts_receivable_USD)),
    n_payables = sum(!is.na(Trade_creditors_USD)),
    .groups = "drop"
  ) %>%
  # Convert to millions for better readability
  mutate(
    avg_receivables_millions = avg_receivables / 1e6,
    avg_payables_millions = avg_payables / 1e6
  )

# Create a long format version for easier plotting
country_quartile_long <- country_quartile_averages %>%
  select(Country, year, quartile_label, avg_receivables_millions, avg_payables_millions) %>%
  pivot_longer(
    cols = c(avg_receivables_millions, avg_payables_millions),
    names_to = "metric",
    values_to = "value_millions"
  ) %>%
  mutate(
    metric = case_when(
      metric == "avg_receivables_millions" ~ "Accounts Receivable",
      metric == "avg_payables_millions" ~ "Accounts Payable"
    )
  )

# Get list of countries
countries <- unique(country_quartile_averages$Country)
countries <- countries[!is.na(countries)]

# ============================================================
# METHOD 1: Separate faceted plots for each quartile
# ============================================================

# Plot for Quartile 1 (Smallest Firms)
q1_plot <- ggplot(country_quartile_long %>% 
                    filter(quartile_label == "Quartile 1 (Smallest Firms)", 
                           !is.na(value_millions)),
                  aes(x = year, y = value_millions, color = metric, group = metric)) +
  geom_line(linewidth = 1) +
  geom_point(size = 1.5, alpha = 0.7) +
  facet_wrap(~ Country, scales = "free_y", ncol = 4) +
  labs(
    title = "Average Accounts Receivable and Payable - Quartile 1 (Smallest Firms)",
    subtitle = "Values in millions of USD | 2003-2023",
    x = "Year",
    y = "Average Amount (Millions USD)",
    color = "Metric",
    caption = "Note: Values are averages across all firms in each country"
  ) +
  theme_minimal() +
  theme(
    legend.position = "bottom",
    axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
    strip.text = element_text(face = "bold", size = 10),
    plot.title = element_text(hjust = 0.5, face = "bold"),
    plot.subtitle = element_text(hjust = 0.5, size = 9),
    legend.title = element_text(face = "bold")
  ) +
  scale_x_continuous(breaks = seq(2005, 2020, by = 5)) +
  scale_color_manual(values = c("Accounts Receivable" = "steelblue", 
                                "Accounts Payable" = "darkorange"))

# Display Quartile 1 plot
print(q1_plot)

# Save Quartile 1 plot
ggsave("~/Desktop/Quartile1_Smallest_Firms_Time_Series.png", 
       plot = q1_plot, width = 14, height = 10, dpi = 300)

