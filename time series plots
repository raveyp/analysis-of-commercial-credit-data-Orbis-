# Create individual plots for each country for Quartile 1
for(country in countries) {
  country_data_q1 <- country_quartile_long %>%
    filter(Country == country, 
           quartile_label == "Quartile 1 (Smallest Firms)",
           !is.na(value_millions))
  
  if(nrow(country_data_q1) > 0) {
    p_q1 <- ggplot(country_data_q1, aes(x = year, y = value_millions, 
                                        color = metric, group = metric)) +
      geom_line(linewidth = 1) +
      geom_point(size = 2, alpha = 0.7) +
      labs(
        title = paste("Average Accounts Receivable and Payable -", country),
        subtitle = "Quartile 1 (Smallest Firms) | 2003-2023",
        x = "Year",
        y = "Average Amount (Millions USD)",
        color = "Metric"
      ) +
      theme_minimal() +
      theme(
        legend.position = "bottom",
        plot.title = element_text(hjust = 0.5, face = "bold"),
        plot.subtitle = element_text(hjust = 0.5)
      ) +
      scale_x_continuous(breaks = seq(2005, 2020, by = 5)) +
      scale_color_manual(values = c("Accounts Receivable" = "steelblue", 
                                    "Accounts Payable" = "darkorange"))
    
    # Save individual plot for Quartile 1
    ggsave(paste0("~/Desktop/Q1_Smallest_Firms_", gsub(" ", "_", country), ".png"), 
           plot = p_q1, width = 10, height = 6, dpi = 300)
    
    cat("Saved Q1 plot for", country, "\n")
  }
}

